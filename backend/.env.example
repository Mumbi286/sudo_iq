# Copy to backend/.env and fill in. Never commit .env.

# PostGIS from docker-compose.yml (host port 5433, because 5432 is often a local PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:mlinzi@localhost:5433/mlinzi

# simulated = fake SMS stored in the messages table; africastalking = real sandbox/live SMS
SMS_PROVIDER=simulated
AT_USERNAME=sandbox
AT_API_KEY=

# true = escalation timers in seconds instead of minutes (demo mode)
SIMULATION=true

# Comma-separated browser origins allowed to call the API
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
