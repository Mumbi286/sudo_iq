# Copy to backend/.env and fill in. Never commit .env.

# PostGIS from docker-compose.yml (host port 5433, because 5432 is often a local PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:mlinzi@localhost:5433/mlinzi

# Auth: generate a secret with  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480
# First admin, created by: python -m app.scripts.seed_reference_data
FIRST_ADMIN_EMAIL=admin@mlinzi.local
FIRST_ADMIN_PASSWORD=change-me-too

# simulated = fake SMS stored in the messages table; africastalking = real sandbox/live SMS
SMS_PROVIDER=simulated
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# WhatsApp: simulated | twilio (free Twilio sandbox works with real numbers that sent "join <code>")
WHATSAPP_PROVIDER=simulated
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_SANDBOX_JOIN_CODE=
TWILIO_VALIDATE_SIGNATURE=true
# Public HTTPS URL of this API (e.g. your cloudflared tunnel), used to verify Twilio signatures
PUBLIC_BASE_URL=

# Used for the cost-per-alert figure (verify current rates)
SMS_UNIT_COST_KES=1.0
WHATSAPP_UNIT_COST_KES=1.0
VOICE_UNIT_COST_KES=4.0

# Escalation: minutes after the alert to resend, call, mark unreachable
ESCALATION_MINUTES_EVACUATE=5,10,20
ESCALATION_MINUTES_WARNING=15,30,60
# true = use the seconds below instead (demo mode)
SIMULATION=true
SIMULATION_ESCALATION_SECONDS=10,20,30

# Comma-separated browser origins allowed to call the API
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
