# Copy to frontend/.env. Vite only exposes variables that start with VITE_.

# Backend base URL (FastAPI)
VITE_API_URL=http://127.0.0.1:8000

# How often the dashboard refreshes, in ms (3s feels live; replaced by WebSocket push in Phase 4)
VITE_POLL_MS=3000

# Default map background: dark | satellite | streets (all keyless, see src/lib/basemaps.js)
VITE_BASEMAP=dark
