# Copy to frontend/.env. Vite only exposes variables that start with VITE_.

# Backend base URL (FastAPI)
VITE_API_URL=http://127.0.0.1:8000

# How often the dashboard refreshes, in ms (replaced by WebSocket push in Phase 4)
VITE_POLL_MS=10000

# Map tiles: CARTO dark basemap (OpenStreetMap data). Swap for
# https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png for the standard OSM look.
VITE_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
